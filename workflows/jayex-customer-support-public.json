        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are an AI customer support classification assistant.\n\nYour task is to analyze incoming customer inquiries and classify them into one of four categories:\n\n1. general_information\n2. appointment\n3. billing\n4. other\n\nReturn ONLY a valid JSON object with these fields:\n\n{\n   \"category\": \"general_information\",\n   \"confidence\": 0.95,\n   \"requiresHumanReview\": false,\n   \"reason\": \"The customer is asking about business hours.\"\n\n}"
            },
            {
              "content": "={{ $json.body.message }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [672, 0],
      "id": "2b1b90f4-364b-4a78-b12f-4702f6ddb2a5",
      "name": "Message a model",
      "credentials": {}
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst text = input.output?.[0]?.content\n  ?.find((part) => part.type === \"output_text\")?.text;\n\nlet result;\n\ntry {\n  if (typeof text !== \"string\") {\n    throw new Error(\"Missing AI response\");\n  }\n\n  result = JSON.parse(text);\n\n  const categories = [\n    \"general_information\",\n    \"appointment\",\n    \"billing\",\n    \"other\",\n  ];\n\n  if (\n    !categories.includes(result.category) ||\n    typeof result.confidence !== \"number\" ||\n    !Number.isFinite(result.confidence) ||\n    result.confidence < 0 ||\n    result.confidence > 1 ||\n    typeof result.requiresHumanReview !== \"boolean\" ||\n    typeof result.reason !== \"string\"\n  ) {\n    throw new Error(\"Invalid AI classification\");\n  }\n} catch (error) {\n  result = {\n    category: \"other\",\n    confidence: 0,\n    requiresHumanReview: true,\n    reason: \"AI output could not be validated\"\n  };\n}\n\n// Apply our safety rules regardles of what the AI reports\nif (\n  result.confidence < 0.8 ||\n  result.category === \"billing\"\n) {\n  result.requiresHumanReview = true;\n}\n\nconst customer = $(\"Webhook\").first().json.body;\n\nreturn [\n  {\n    json: {\n      customerName: customer.customerName,\n      email: customer.email,\n      message: customer.message,\n      testId: customer.testId || \"\",\n      ...result,\n    },\n  },\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
