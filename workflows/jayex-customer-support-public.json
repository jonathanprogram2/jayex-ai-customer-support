      "id": "bd0b7b0e-e1b2-4802-9c59-78b4644e7ad5",
      "name": "Notify Human Reviewer",
      "webhookId": "",
      "credentials": {}
    },
    {
      "parameters": {
        "jsCode": "const request = $input.first().json;\nconst body = request.body ?? {};\n\nconst customerName = body.customerName;\nconst email = body.email;\nconst message = body.message;\n\nconst errors = [];\n\nif (typeof customerName !== \"string\" || !customerName.trim()) {\n  errors.push(\"Customer name is required.\");\n}\n\nif (\n  typeof email !== \"string\" ||\n  !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email.trim()) ||\n  email.trim().length > 254\n) {\n  errors.push(\"A valid email address is required.\");\n}\n\nif (typeof message !== \"string\" || !message.trim()) {\n  errors.push(\"Customer message is required.\")\n}\n\nif (typeof customerName === \"string\" && customerName.length > 100) {\n  errors.push(\"Customer name is too long.\");\n}\n\nif (typeof message === \"string\" && message.length > 2000) {\n  errors.push(\"Customer message is too long.\");\n}\n\n\nreturn [\n  {\n    json: {\n      ...request,\n      body: {\n        customerName: typeof customerName === \"string\" ? customerName.trim() : \"\",\n        email: typeof email === \"string\" ? email.trim() : \"\",\n        message: typeof message === \"string\" ? message.trim() : \"\",\n        testId: typeof body.testId === \"string\"\n        ? body.testId\n          : \"\",\n      },\n      validation: {\n        valid: errors.length === 0,\n        errors,\n      },\n    },\n  },\n];"
      },
